[Unit]
Description=Network path echo responder
After=network-online.target
Wants=network-online.target

[Service]
# The shared secret. systemd reads this as root before dropping to the dynamic user, so the
# file stays 0600 root-owned. Without it the server runs in open mode and will answer
# anyone — see lok-wire's module docs on why that matters on a public IP.
EnvironmentFile=/etc/__PREFIX__/echo.env
ExecStart=/usr/local/bin/__PREFIX__-echo __LISTEN__
Restart=always
RestartSec=2
# Port is >1024, so no privileges needed — run as a throwaway dynamic user, hardened.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

[Unit]
Description=Periodic network path measurement (jittered)

[Timer]
OnBootSec=1min
OnUnitActiveSec=__INTERVAL__
# Jitter so runs don't form a regular, fingerprintable cadence. Gentleness is a safety
# property, not a performance one — keep the interval loose.
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target

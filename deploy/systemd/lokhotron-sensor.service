[Unit]
# Descriptions are deliberately generic: this unit file lands on the RU sensor, where the
# project name would tie the box to the public repo. See DEPLOY.md "The name invariant".
Description=Network path measurement (one run)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=LOK_PREFIX=__PREFIX__
ExecStart=/usr/local/bin/__PREFIX__-run-battery
# The AF_PACKET capture (injected-RST detection + TTL calibration) needs CAP_NET_RAW.
# Runs as root by default, which has it. Hardened alternative: add a dedicated User= and keep
# the two capability lines below so it runs with CAP_NET_RAW and nothing else.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

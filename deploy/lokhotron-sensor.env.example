# Lokhotron sensor config. Installed to /etc/lokhotron/sensor.env on first setup, 0600.
# Coarse tags only — never add a user identifier, device id, or precise location.

# The non-RU echo server this sensor probes (host:port).
SERVER=__SERVER__

# Marked datagrams per battery run.
COUNT=__COUNT__

# Shared secret with the echo server, 64 hex chars. It is what makes an arrival provable:
# without the matching key the server ignores this sensor entirely, and every run reads as a
# total block. Rotate by editing this and /etc/lokhotron/echo.env on the server together.
LOK_PROBE_KEY=__KEY__

# This box's operator ASN and coarse region, used to tag verdicts. FILL THESE IN — the data
# is meaningless (and mis-attributed) until you do. Region is a coarse code, not a city/GPS.
ASN=0
REGION=unknown

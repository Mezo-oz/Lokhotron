# Lokhotron sensor config. Installed to /etc/lokhotron/sensor.env on first setup.
# Coarse tags only — never add a user identifier, device id, or precise location.

# The non-RU echo server this sensor probes (host:port).
SERVER=__SERVER__

# Marked datagrams per battery run.
COUNT=__COUNT__

# This box's operator ASN and coarse region, used to tag verdicts. FILL THESE IN — the data
# is meaningless (and mis-attributed) until you do. Region is a coarse code, not a city/GPS.
ASN=0
REGION=unknown
